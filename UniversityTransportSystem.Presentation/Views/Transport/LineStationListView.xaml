<UserControl x:Class="UniversityTransportSystem.Presentation.Views.Transport.LineStationListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RenderTransformOrigin="0.5,0.5">
    <UserControl.RenderTransform>
        <TranslateTransform X="0" Y="0"/>
    </UserControl.RenderTransform>
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Line Station Management" Style="{StaticResource HeaderTitleStyle}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="txtSearch" Style="{StaticResource SearchBoxStyle}" TextChanged="TxtSearch_TextChanged" Margin="8,0" VerticalAlignment="Center"/>
            <Button Grid.Column="2" x:Name="btnEdit" Content="Edit" Style="{StaticResource ActionButtonStyle}" Click="BtnEdit_Click" Width="70" Margin="4,0" Height="36"/>
            <Button Grid.Column="3" x:Name="btnDelete" Content="Delete" Style="{StaticResource DangerButtonStyle}" Click="BtnDelete_Click" Width="70" Margin="4,0" Height="36"/>
            <Button Grid.Column="4" x:Name="btnRefresh" Content="Refresh" Style="{StaticResource SecondaryActionButtonStyle}" Click="BtnRefresh_Click" Width="70" Margin="4,0" Height="36"/>
            <Button Grid.Column="5" x:Name="btnAdd" Content="+ Add Line Station" Style="{StaticResource ActionButtonStyle}" Click="BtnAdd_Click" Height="36" Width="100"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="0">
            <DataGrid x:Name="dgLineStations"
                      Style="{StaticResource DataGridStyle}"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource DataGridRowStyle}"
                      CellStyle="{StaticResource DataGridCellStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="LineStationID" Binding="{Binding LineStationID}" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="TransportLineID" Binding="{Binding TransportLineID}" Width="Auto" MinWidth="100"/>
                    <DataGridTextColumn Header="StationID" Binding="{Binding StationID}" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="Station Order" Binding="{Binding StationOrder}" Width="Auto" MinWidth="100"/>
                    <DataGridTextColumn Header="Distance (km)" Binding="{Binding DistanceFromOrigin}" Width="*" MinWidth="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
