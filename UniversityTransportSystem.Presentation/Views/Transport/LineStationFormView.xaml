<UserControl x:Class="UniversityTransportSystem.Presentation.Views.Transport.LineStationFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RenderTransformOrigin="0.5,0.5">
    <UserControl.RenderTransform>
        <TranslateTransform X="0" Y="0"/>
    </UserControl.RenderTransform>
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Add Line Station" Style="{StaticResource HeaderTitleStyle}" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="28" MaxWidth="600" HorizontalAlignment="Left">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Transport Line ID" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="1" x:Name="txtTransportLineID" Style="{StaticResource TextBoxStyle}"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Station ID" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="1" x:Name="txtStationID" Style="{StaticResource TextBoxStyle}"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Station Order" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="1" x:Name="txtStationOrder" Style="{StaticResource TextBoxStyle}"/>
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Distance From Origin (km)" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="1" x:Name="txtDistanceFromOrigin" Style="{StaticResource TextBoxStyle}"/>
                </Grid>

                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="btnSave" Content="Save" Style="{StaticResource ActionButtonStyle}" Click="BtnSave_Click" Width="120" Margin="0,0,12,0"/>
                    <Button Grid.Column="1" x:Name="btnCancel" Content="Cancel" Style="{StaticResource SecondaryActionButtonStyle}" Click="BtnCancel_Click" Width="120"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
