<UserControl x:Class="UniversityTransportSystem.Presentation.Views.People.PersonFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RenderTransformOrigin="0.5,0.5"
             Loaded="UserControl_Loaded">
    <UserControl.RenderTransform>
        <TranslateTransform X="0" Y="20"/>
    </UserControl.RenderTransform>
    <UserControl.Resources>
        <Storyboard x:Key="PageEnter">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>
    <Grid Margin="28,0,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,8,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="btnBack" Content="← Back" Style="{StaticResource SecondaryActionButtonStyle}" Height="36" Width="100" Click="BtnBack_Click" Margin="0,0,16,0"/>
            <TextBlock Grid.Column="1" Text="Person Form" Style="{StaticResource HeaderTitleStyle}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Form Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Form Fields -->
            <Border Grid.Column="0" Style="{StaticResource CardContentStyle}" Margin="0,0,12,0">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="PERSON INFORMATION" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,14">
                        <TextBlock Text="First Name" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtFirstName" Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,14">
                        <TextBlock Text="Middle Name" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtMidName" Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,14">
                        <TextBlock Text="Last Name" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtLastName" Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,14">
                        <TextBlock Text="Date of Birth" Style="{StaticResource LabelStyle}"/>
                        <DatePicker x:Name="dpDateOfBirth" Style="{StaticResource DatePickerStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,14">
                        <TextBlock Text="Gender" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="cmbGender" Style="{StaticResource ComboBoxStyle}" ItemContainerStyle="{StaticResource ComboBoxItemStyle}">
                            <ComboBoxItem Content="Male"/>
                            <ComboBoxItem Content="Female"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,14">
                        <TextBlock Text="Phone Number" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtPhoneNumber" Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,14">
                        <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtEmail" Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="8,0,0,14">
                        <TextBlock Text="Address" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtAddress" Style="{StaticResource TextBoxStyle}" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Preview Card -->
            <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PREVIEW" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/>

                    <Border Grid.Row="1"
                            Width="80" Height="80"
                            CornerRadius="40"
                            Background="{StaticResource PrimaryButtonBrush}"
                            HorizontalAlignment="Center"
                            Effect="{StaticResource GoldGlowShadow}"
                            Margin="0,0,0,16">
                        <TextBlock x:Name="txtPreviewInitials" Text="--" FontSize="28" FontWeight="Bold" Foreground="#0C1429" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="txtPreviewName" Text="Full Name" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtPreviewEmail" Text="Email" FontSize="13" Foreground="#9CB0D1" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource ProfileCardStyle}" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="DOB:" Foreground="#9CB0D1" FontSize="12"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtPreviewDOB" Text="--" Foreground="#FFFFFF" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Gender:" Foreground="#9CB0D1" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtPreviewGender" Text="--" Foreground="#FFFFFF" FontSize="12"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ProfileCardStyle}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Phone:" Foreground="#9CB0D1" FontSize="12"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtPreviewPhone" Text="--" Foreground="#FFFFFF" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Address:" Foreground="#9CB0D1" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtPreviewAddress" Text="--" Foreground="#FFFFFF" FontSize="12"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Buttons -->
        <Border Grid.Row="2" Margin="0,16,0,16" Background="Transparent">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnSave" Content="Save" Style="{StaticResource ActionButtonStyle}" Width="110" Margin="0,0,8,0" Click="BtnSave_Click"/>
                <Button x:Name="btnUpdate" Content="Update" Style="{StaticResource ActionButtonStyle}" Width="110" Margin="0,0,8,0" Click="BtnUpdate_Click" Visibility="Collapsed"/>
                <Button x:Name="btnClear" Content="Clear" Style="{StaticResource SecondaryActionButtonStyle}" Width="100" Margin="0,0,8,0" Click="BtnClear_Click"/>
                <Button x:Name="btnCancel" Content="Cancel" Style="{StaticResource DangerButtonStyle}" Width="100" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
