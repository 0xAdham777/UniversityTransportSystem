<UserControl x:Class="UniversityTransportSystem.Presentation.Views.People.EmployeeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RenderTransformOrigin="0.5,0.5"
             Loaded="UserControl_Loaded">
    <UserControl.RenderTransform>
        <TranslateTransform X="0" Y="20"/>
    </UserControl.RenderTransform>
    <UserControl.Resources>
        <Storyboard x:Key="PageEnter">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>
    <Grid Margin="28,0,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,8,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Employee Management" Style="{StaticResource HeaderTitleStyle}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Manage all employee records" Style="{StaticResource HeaderSubTitleStyle}" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <Button Grid.Column="2" x:Name="btnAddEmployee" Content="+ Add Employee" Style="{StaticResource ActionButtonStyle}" Height="40" Width="150" Click="BtnAddEmployee_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Margin="0,0,8,0">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="OVERVIEW" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                    <TextBlock Grid.Row="1" x:Name="txtTotalEmployees" Text="0" FontSize="36" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,8,0,4"/>
                    <TextBlock Grid.Row="2" Text="Total Employees" FontSize="13" Foreground="#9CB0D1"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Margin="8,0">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="STATUS" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                    <TextBlock Grid.Row="1" x:Name="txtActiveEmployees" Text="0" FontSize="36" FontWeight="Bold" Foreground="#1DE5A8" Margin="0,8,0,4"/>
                    <TextBlock Grid.Row="2" Text="Active Employees" FontSize="13" Foreground="#9CB0D1"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Margin="8,0,0,0">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="ACTIONS" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                    <TextBlock Grid.Row="1" Text="Quick Actions" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,8,0,4"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Export" Style="{StaticResource SecondaryActionButtonStyle}" Height="28" FontSize="11" Padding="10,0" Margin="0,0,6,0"/>
                        <Button Content="Print" Style="{StaticResource SecondaryActionButtonStyle}" Height="28" FontSize="11" Padding="10,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardContentStyle}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="txtSearch" Style="{StaticResource SearchBoxStyle}" TextChanged="TxtSearch_TextChanged" Width="320" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnEditEmployee" Content="Edit" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,8,0" Width="90" Click="BtnEditEmployee_Click"/>
                    <Button x:Name="btnDeleteEmployee" Content="Delete" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" Width="90" Click="BtnDeleteEmployee_Click"/>
                    <Button x:Name="btnRefresh" Content="Refresh" Style="{StaticResource GreenActionButtonStyle}" Width="100" Click="BtnRefresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="3" x:Name="dgEmployees"
                  Style="{StaticResource DataGridStyle}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  RowStyle="{StaticResource DataGridRowStyle}"
                  CellStyle="{StaticResource DataGridCellStyle}"
                  SelectionChanged="DgEmployees_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="EmployeeID" Binding="{Binding EmployeeID}" Width="100"/>
                <DataGridTextColumn Header="PersonID" Binding="{Binding PersonID}" Width="100"/>
                <DataGridTextColumn Header="HireDate" Binding="{Binding HireDate, StringFormat={}{0:yyyy-MM-dd}}" Width="130"/>
                <DataGridTextColumn Header="EmployeeStatus" Binding="{Binding EmployeeStatus, Converter={StaticResource BoolToStatusConverter}}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
