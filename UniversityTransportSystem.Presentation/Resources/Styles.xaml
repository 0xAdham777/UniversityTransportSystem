<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Converters="clr-namespace:UniversityTransportSystem.Presentation.Converters">

    <!-- COLORS -->
    <Color x:Key="WindowBackground">#0C1429</Color>
    <Color x:Key="CardBackground">#13203F</Color>
    <Color x:Key="SidebarBackground">#0A1022</Color>
    <Color x:Key="Accent">#D4AF37</Color>
    <Color x:Key="Cyan">#33C7FF</Color>
    <Color x:Key="Green">#1DE5A8</Color>
    <Color x:Key="Pink">#E54D6A</Color>
    <Color x:Key="MutedText">#9CB0D1</Color>
    <Color x:Key="BorderColor">#233967</Color>
    <Color x:Key="InputBackground">#0D1730</Color>
    <Color x:Key="HoverBackground">#1D3568</Color>
    <Color x:Key="SelectionBackground">#2A3E72</Color>
    <Color x:Key="AlternatingRow">#111D3A</Color>
    <Color x:Key="GridLine">#1A2D52</Color>
    <Color x:Key="GoldDark">#B8962E</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="DarkGold">#8B7322</Color>

    <!-- BRUSHES -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0C1429"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#13203F"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0A1022"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#D4AF37"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#33C7FF"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#1DE5A8"/>
    <SolidColorBrush x:Key="PinkBrush" Color="#E54D6A"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9CB0D1"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#233967"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0D1730"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#1D3568"/>
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#2A3E72"/>
    <SolidColorBrush x:Key="AlternatingRowBrush" Color="#111D3A"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#1A2D52"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="GoldDarkBrush" Color="#B8962E"/>
    <SolidColorBrush x:Key="CardBackgroundWithOpacity" Color="#13203F"/>

    <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D4AF37" Offset="0.0"/>
        <GradientStop Color="#B8962E" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryButtonHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E0C04A" Offset="0.0"/>
        <GradientStop Color="#C4A032" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0A1022" Offset="0.0"/>
        <GradientStop Color="#0C1429" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldGlowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D4AF37" Offset="0.0"/>
        <GradientStop Color="#FFD700" Offset="0.5"/>
        <GradientStop Color="#D4AF37" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- EFFECTS -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.4" Direction="270"/>
    <DropShadowEffect x:Key="GlowShadow" BlurRadius="25" ShadowDepth="0" Color="#D4AF37" Opacity="0.3"/>
    <DropShadowEffect x:Key="GoldGlowShadow" BlurRadius="30" ShadowDepth="0" Color="#D4AF37" Opacity="0.5"/>
    <DropShadowEffect x:Key="LightShadow" BlurRadius="10" ShadowDepth="2" Color="#000000" Opacity="0.3" Direction="270"/>
    <DropShadowEffect x:Key="ButtonShadow" BlurRadius="12" ShadowDepth="3" Color="#000000" Opacity="0.4" Direction="270"/>

    <!-- ANIMATIONS / STORYBOARDS -->
    <Storyboard x:Key="WindowEnterStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.97" To="1" Duration="0:0:0.4">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.97" To="1" Duration="0:0:0.4">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="PageEnterStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="ButtonHoverOnStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.15">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.15">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="ButtonHoverOffStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="CardHoverOnStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.2">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.2">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#D4AF37" Duration="0:0:0.2"/>
    </Storyboard>

    <Storyboard x:Key="CardHoverOffStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.2">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.2">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#233967" Duration="0:0:0.2"/>
    </Storyboard>

    <!-- CONVERTERS -->
    <Converters:GenderConverter x:Key="GenderConverter"/>
    <Converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
    <Converters:InverseBoolConverter x:Key="InverseBoolConverter"/>

    <!-- STYLES -->

    <!-- GlassCardStyle -->
    <Style x:Key="GlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#13203F"/>
        <Setter Property="BorderBrush" Value="#233967"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource CardHoverOnStoryboard}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource CardHoverOffStoryboard}"/>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- GlassCardWithGlowStyle -->
    <Style x:Key="GlassCardWithGlowStyle" TargetType="Border">
        <Setter Property="Background" Value="#13203F"/>
        <Setter Property="BorderBrush" Value="#233967"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource CardHoverOnStoryboard}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource CardHoverOffStoryboard}"/>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- SidebarButtonStyle -->
    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#9CB0D1"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Effect="{StaticResource LightShadow}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Background.Color" To="#1D3568" Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetProperty="Foreground.Color" To="#FFFFFF" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Background.Color" To="Transparent" Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetProperty="Foreground.Color" To="#9CB0D1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#152A55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ActionButtonStyle (Primary - Gold) -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}"/>
        <Setter Property="Foreground" Value="#0C1429"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Effect="{StaticResource ButtonShadow}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Background.(GradientBrush.GradientStops)[0].Color" To="#E0C04A" Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Background.(GradientBrush.GradientStops)[1].Color" To="#C4A032" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Background.(GradientBrush.GradientStops)[0].Color" To="#D4AF37" Duration="0:0:0.15"/>
                                        <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Background.(GradientBrush.GradientStops)[1].Color" To="#B8962E" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#8B7322"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

